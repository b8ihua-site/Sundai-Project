%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5044155c121271047bd114541f8ded63, type: 3}
  m_Name: QuizDatabase
  m_EditorClassIdentifier: Assembly-CSharp::QuizDatabase
  subjects:
  - subjectName: "市ヶ谷"
    questions:
    - question: "市ヶ谷駅に乗り入れるJR路線で、オレンジ色のラインカラーで知られる路線は？"
      answer: "ちゅうおうせん"
    - question: "「駿台」、正式名称は？"
      answer: "すんだいよびがっこう"
    - question: "市ヶ谷は何区にある？"
      answer: "しんじゅくく"
    - question: "市ヶ谷駅のすぐ近くを流れる、江戸城の外堀にあたる水辺は？"
      answer: "そとぼり"
    - question: "市ヶ谷駅と市谷見附の間、外堀にかかる橋の名前は？"
      answer: "いちがやばし"
    - question: "市ヶ谷にある、日本の防衛を担う省庁は？"
      answer: "ぼうえいしょう"
    - question: "市ヶ谷から飯田橋・水道橋方面へ向かう、JR中央線と並走する路線は？"
      answer: "そぶせん"
    - question: "市ヶ谷駅から歩いて行ける、桜の名所として知られる土手沿いの道は？"
      answer: "そとぼりどおり"
    - question: "市ヶ谷にメインキャンパスを構える、「HOSEI」のロゴで知られる大学は？"
      answer: "ほうせいだいがく"
    - question: "市ヶ谷駅前にある、江戸城の見附（城門）の跡地の名称は？"
      answer: "いちがやみつけ"
  - subjectName: "数学"
    questions:
    - question: "二次方程式の解の種類を判定するのに使われる「b²-4ac」を何という？"
      answer: "はんべつしき"
    - question: "関数上のある点における接線の傾きを表す値を何という？"
      answer: "びぶんけいすう"
    - question: "関数が増加から減少（またはその逆）に転じる点での関数の値を何という？"
      answer: "きょくち"
    - question: "xの値を1つ決めるとyの値がただ1つに決まる対応関係を何という？"
      answer: "かんすう"
    - question: "異なるn個のものから、順番を区別してr個並べる場合の数を何という？"
      answer: "じゅんれつ"
    - question: "異なるn個のものから、順番を区別せずr個選ぶ場合の数を何という？"
      answer: "くみあわせ"
    - question: "nを限りなく大きくしたときに、数列が近づいていく値を何という？"
      answer: "きょくげん"
    - question: "大きさがちょうど1であるベクトルを何という？"
      answer: "たんいべくとる"
    - question: "確率変数がとる値の平均を表す統計用語は？"
      answer: "きたいち"
    - question: "要素を1つも含まない集合を何という？"
      answer: "くうしゅうごう"
  - subjectName: "理科"
    questions:
    - question: "植物の細胞の中で、光合成を行う細胞小器官は？"
      answer: "ようりょくたい"
    - question: "動物・植物どちらの細胞にもあり、呼吸を行いエネルギーを作る細胞小器官は？"
      answer: "みとこんどりあ"
    - question: "酸とアルカリが反応して、塩と水ができる反応を何という？"
      answer: "ちゅうわ"
    - question: "原子核のまわりを回っている、負の電気を帯びた粒子は？"
      answer: "でんし"
    - question: "力を加えられなければ物体は静止・等速直線運動を続けるという法則は？"
      answer: "かんせいのほうそく"
    - question: "原子が電子を失って正の電気を帯びたものを何という？"
      answer: "よういおん"
    - question: "DNAが持つ、はしごをねじったような立体構造を何という？"
      answer: "にじゅうらせん"
    - question: "地球の大気のうち、オゾン層が存在する層は？"
      answer: "せいそうけん"
    - question: "高い位置にある物体が、その位置に応じて持つエネルギーを何という？"
      answer: "いちえねるぎー"
    - question: "生物が外界の変化に関わらず、体内の状態を一定に保とうとする性質を何という？"
      answer: "こうじょうせい"
